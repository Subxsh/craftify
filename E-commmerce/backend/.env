# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# For MongoDB Atlas, use the connection string from your Atlas dashboard
# Format: mongodb+srv://<username>:<password>@<cluster-url>/craftify?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://SubashP:subash25@cluster0.ib61c1f.mongodb.net/Craftify?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/craftify?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=craftify_super_secret_jwt_key_2024_handmade_marketplace
JWT_EXPIRE=7d

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Stripe Payment (for checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload Limits
