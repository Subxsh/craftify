# Production environment variables for React frontend on Vercel
# Backend API URL - Same domain for Vercel deployment
REACT_APP_API_URL=/api

# Disable CI mode to prevent warnings from being treated as errors
CI=false
GENERATE_SOURCEMAP=false

# Stripe Publishable Key (if using payments)
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key