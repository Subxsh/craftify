# Production environment variables for React frontend
# You'll set this in your Render static site environment

# Backend API URL - Replace with your actual backend service URL from Render
REACT_APP_API_URL=https://craftify-backend.onrender.com/api

# Stripe Publishable Key (if using payments)
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Other frontend config
GENERATE_SOURCEMAP=false